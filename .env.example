# ============================================================
# Copy file nay thanh .env roi dien gia tri thuc:
#     cp .env.example .env
# File .env da nam trong .gitignore - KHONG commit len git.
# ============================================================

TZ=Asia/Ho_Chi_Minh

# ---------------- Postgres ----------------
POSTGRES_DB=dmb
POSTGRES_USER=dmb
# Dat mat khau manh, vi du: openssl rand -base64 24
POSTGRES_PASSWORD=doi_mat_khau_nay

# ---------------- Grafana ----------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=doi_mat_khau_nay
GRAFANA_PORT=3000

# ---------------- Nguon du lieu ----------------
DMB_API_URL=https://34.64.189.31/api/cloneList
# Server dung self-signed cert nen de false
DMB_API_VERIFY_SSL=false
DMB_API_TIMEOUT=60
DMB_API_RETRIES=3
# Timezone cua truong last_seen (thiet bi bao gio local cua no)
DMB_SOURCE_TZ=Asia/Ho_Chi_Minh

# ---------------- Pham vi monitor ----------------
# Nhieu region thi cach nhau bang dau phay: Vietnam,Thailand
# De trong = lay tat ca region
DMB_REGIONS=Vietnam
DMB_EXCEPTION_LIST=data/Exception_list.txt

# ---------------- Vong lap ----------------
DMB_INTERVAL_SECONDS=300
# Quiet hours: van ghi DB nhung khong gui notification
DMB_QUIET_START_HOUR=22
DMB_QUIET_END_HOUR=5
# Tong hop dau ngay: liet ke tat ca thiet bi dang Off
DMB_DAILY_SUMMARY_ENABLED=true
DMB_DAILY_SUMMARY_AT=08:00
# Lan dau chay tren DB rong: co gui notification cho toan bo thiet bi Off khong?
DMB_NOTIFY_ON_FIRST_RUN=false
# Canh bao len Bitrix sau N lan fetch that bai lien tiep
DMB_ALERT_AFTER_FAILURES=3
# Event Off chua gui duoc thi thu lai trong bao nhieu gio roi bo qua
DMB_PENDING_MAX_AGE_HOURS=6
DMB_LOG_LEVEL=INFO

# ---------------- Bitrix24 ----------------
BITRIX_ENABLED=true
# QUAN TRONG: token webhook cu da bi commit len git -> hay REVOKE va tao token moi
BITRIX_WEBHOOK_URL=https://erp.dnsvn.com/rest/<user_id>/<token_moi>/
BITRIX_CHAT_ID=911
BITRIX_TIMEOUT=30
